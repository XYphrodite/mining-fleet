# systemd unit for Linux mining nodes.
#
#   sudo cp -r ./agent /opt/mining-fleet-agent
#   sudo cp mining-fleet-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mining-fleet-agent
#
# Root is needed to read hwmon sensors and to control the miner process.
# Restrict the port to the tailnet, e.g.:
#   sudo ufw allow in on tailscale0 to any port 47800 proto tcp

[Unit]
Description=mining-fleet agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=notify
User=root
WorkingDirectory=/opt/mining-fleet-agent
ExecStart=/opt/mining-fleet-agent/mining-fleet-agent
Restart=always
RestartSec=5
Environment=DOTNET_ENVIRONMENT=Production

[Install]
WantedBy=multi-user.target
